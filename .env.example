APP_NAME=FixIt API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fixit
CORS_ORIGINS=["http://localhost:8081"]

# JWT authentication configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Postgres container (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fixit

# Host port for Postgres. Change it (and DATABASE_URL above) if 5432 is already taken.
POSTGRES_PORT=5432

